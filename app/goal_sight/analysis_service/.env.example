# GoalSight Analysis Service — environment template. Copy to `.env`.

# Absolute path to the football_ai model project root (contains main.py,
# config/, weights/, outputs/). On AWS this is the mounted volume path.
GOALSIGHT_MODEL_DIR=/opt/football_ai
GOALSIGHT_MODEL_CONFIG=config/config.yaml

# Inference device: cuda:0 (GPU) | cpu | auto
GOALSIGHT_DEVICE=cuda:0

# Server bind + the public URL the mobile app uses to reach this service
# (so crop/video URLs are absolute). Leave blank for relative URLs.
GOALSIGHT_HOST=0.0.0.0
GOALSIGHT_PORT=8000
GOALSIGHT_PUBLIC_BASE_URL=

# Per-run timeout (seconds).
GOALSIGHT_JOB_TIMEOUT=3600

# Supabase (used by the persistence step — added after the DB schema lands).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GOALSIGHT_BUCKET_VIDEOS=match-videos
GOALSIGHT_BUCKET_HEATMAPS=heatmaps
GOALSIGHT_BUCKET_REPORTS=reports
